diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index 4879c5c..61497b7 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -70,3 +70,38 @@ jobs:
           echo "exit code: $rc"
           test "$rc" = 1
           grep -q 'VSWAP: short read' run.txt
+
+  # The browser build (WOLF-41), without game data and without deploying.
+  web:
+    runs-on: ubuntu-24.04
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Install dependencies
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y --no-install-recommends cmake ninja-build python3
+
+      - name: emsdk
+        run: |
+          git clone --depth 1 https://github.com/emscripten-core/emsdk.git "$HOME/emsdk"
+          "$HOME/emsdk/emsdk" install 6.0.10
+          "$HOME/emsdk/emsdk" activate 6.0.10
+
+      - name: Configure (no game data)
+        run: |
+          source "$HOME/emsdk/emsdk_env.sh"
+          emcc --version | head -1
+          cmake --preset web -DWOLF3D_WEB_DATA=
+
+      - name: Build
+        run: |
+          source "$HOME/emsdk/emsdk_env.sh"
+          cmake --build --preset web 2>&1 | tee build.log
+          echo "Game warnings: $(grep -E '/(WOLFSRC|port)/.*warning:' build.log | wc -l)"
+
+      - name: Check the output
+        run: |
+          ls -l build-web/raylib_wolf3d.html build-web/raylib_wolf3d.js build-web/raylib_wolf3d.wasm
+          # never bundle game data in CI
+          test ! -e build-web/raylib_wolf3d.data
