# Template for serving the browser build from Apache or LiteSpeed (WOLF-43).
# The build copies it next to raylib_wolf3d.html; upload the five files and
# this one to a directory such as /wolf3d/ (scripts/deploy_web.sh does it).
# All URLs in the page are relative, and it needs no COOP/COEP headers.

# /wolf3d/ opens the game.  Deploy can rename the page to index.html.
DirectoryIndex index.html raylib_wolf3d.html

# No directory listing (WOLF-46).
Options -Indexes

# WebAssembly must be served as application/wasm for streaming compilation.
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/octet-stream .data
  AddType text/javascript .js
</IfModule>

# Compress text and the wasm (LiteSpeed adds brotli on its own when enabled;
# the .data package is mostly compressed game data but still gains a bit).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/javascript application/javascript application/wasm application/octet-stream
</IfModule>

# The file names do not change between builds, so the browser must check
# for a newer copy each time (an unchanged file is a cheap 304 thanks to the
# ETag).  The page and its .js, .wasm and .data always come from one build.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|wasm|data)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
