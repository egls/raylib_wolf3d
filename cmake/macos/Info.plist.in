<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Wolfenstein 3-D (raylib)</string>
	<key>CFBundleExecutable</key>
	<string>@WOLF3D_BUNDLE_EXECUTABLE@</string>
	<key>CFBundleIdentifier</key>
	<string>@WOLF3D_BUNDLE_ID@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>raylib_wolf3d</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@WOLF3D_BUNDLE_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@WOLF3D_BUNDLE_VERSION@</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.action-games</string>
	<key>LSMinimumSystemVersion</key>
	<string>@CMAKE_OSX_DEPLOYMENT_TARGET@</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Wolfenstein 3D (C) 1992 id Software, Inc. Port: https://github.com/raydelto/raylib_wolf3d</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
